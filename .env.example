# Victim Agent environment configuration template
#
# IMPORTANT
# ---------
# This file is only a template. Python does not read .env files automatically.
#
# Creating a local file with:
#
#   cp .env.example .env
#
# does NOT by itself place these values into the process environment.
#
# For direct host execution, export the variables before starting Python:
#
#   set -a
#   source .env
#   set +a
#   python3 -m victim_agent.agent --ticket-id TICKET-001
#
# For Docker Compose, the victim_agent service must explicitly include:
#
#   env_file:
#     - .env
#
# Docker Compose may also read .env for variable substitution, but the service
# still needs env_file or environment entries to receive these variables.
#
# Never commit the real .env file. Keep secrets out of both .env.example and
# experiment logs. The current Victim Agent configuration does not require
# credentials or API keys.


# ---------------------------------------------------------------------------
# Required model selection
# ---------------------------------------------------------------------------

# REQUIRED.
#
# Select the exact Ollama model tag used for this experiment run.
# There is intentionally no default model, so an experiment cannot silently
# run with a different model than intended.
#
# Example format:
#   VICTIM_MODEL=your-model:tag
#
# Leave this empty only while using the file as a template. Before running the
# Victim Agent, set this variable or provide the CLI option:
#
#   --model your-model:tag
VICTIM_MODEL=


# ---------------------------------------------------------------------------
# Ollama connection boundary
# ---------------------------------------------------------------------------

# Ollama server root URL.
#
# Typical direct host execution:
#   http://localhost:11434
#
# Typical Docker-to-host execution:
#   http://host.docker.internal:11434
#
# Typical Docker Compose service-to-service execution:
#   http://ollama:11434
#
# Choose one URL that matches the deployment topology. Do not include
# credentials, paths, query strings, or fragments.
OLLAMA_BASE_URL=http://localhost:11434

# Comma-separated hostnames that the Victim Agent may contact for Ollama.
#
# These values are hostnames only, not URLs. Keep the list as narrow as the
# active deployment permits.
OLLAMA_ALLOWED_HOSTS=localhost,127.0.0.1,::1,host.docker.internal,ollama

# Comma-separated TCP ports that the Victim Agent may use for Ollama.
#
# Phase 1 permits only Ollama's standard local API port.
OLLAMA_ALLOWED_PORTS=11434


# ---------------------------------------------------------------------------
# Model execution settings
# ---------------------------------------------------------------------------

# Structured-output mode:
#   schema  - send the complete JSON schema to Ollama
#   json    - request JSON output without the complete schema
#   prompt  - rely on the system prompt plus host-side validation
#
# Keep this identical across compared models.
VICTIM_STRUCTURED_MODE=schema

# Sampling temperature. Use the same value across compared models.
VICTIM_TEMPERATURE=0

# Context length in tokens. Must be a base-10 integer.
VICTIM_NUM_CTX=8192

# Maximum number of Victim Agent decision steps. Must be an integer from 1 to 50.
VICTIM_MAX_STEPS=8

# Per-request Ollama timeout in seconds.
VICTIM_LLM_TIMEOUT_SECONDS=120


# ---------------------------------------------------------------------------
# Runtime logging
# ---------------------------------------------------------------------------

# Directory for Victim Agent execution traces.
#
# For Docker, mount this directory or replace it with the corresponding
# container path so logs persist outside the container.
VICTIM_LOG_DIR=logs/victim_agent

# "full" (default) writes the complete run trace to disk, including raw
# ticket and knowledge-base content. "redacted" writes a copy with
# free-text ticket/article fields (subject, description, note, title,
# content, snippet, query) replaced by a non-reversible digest instead.
# Either way, the in-memory result returned by run_victim_agent is always
# complete; only the file on disk is affected.
#
# Keep this set to "full" only while every ticket/knowledge-base fixture is
# synthetic. Switch to "redacted" before ever pointing this project at
# tickets or articles that could contain real user data.
VICTIM_LOG_MODE=full
