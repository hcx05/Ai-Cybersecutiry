# Required: select explicitly for each experiment run.
# Examples:
# llama3.1:8b
# qwen3:8b
# ministral-3:8b
VICTIM_MODEL=

# Ollama API location.
OLLAMA_BASE_URL=http://localhost:11434

# Hosts the Victim Agent is permitted to contact.
OLLAMA_ALLOWED_HOSTS=localhost,127.0.0.1,::1,host.docker.internal,ollama

# schema, json, or prompt
VICTIM_STRUCTURED_MODE=schema

# Keep these consistent across compared models.
VICTIM_TEMPERATURE=0
VICTIM_NUM_CTX=8192
VICTIM_MAX_STEPS=8
VICTIM_LLM_TIMEOUT_SECONDS=120

# Victim Agent execution traces.
VICTIM_LOG_DIR=logs/victim_agent
